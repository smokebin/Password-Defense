<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into the linker-generated manifest (see <Manifest Include> in program.vcxproj). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Process ANSI code page = UTF-8 (Windows 10 1903+). Every path string in the
           app is UTF-8; this makes any narrow Win32/CRT/std::filesystem call agree with
           SQLite and ImGui. Critical vault paths also convert explicitly (tools/u8path.h),
           so they stay correct on systems that ignore this setting. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

// Application icon
1 ICON "idealv2.ico"

#include <winver.h>

// Version / product metadata so the built .exe has populated file properties
// (Company/Product/Description) instead of blank fields.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "keo"
            VALUE "FileDescription",  "Password Defense - offline password manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PasswordDefense"
            VALUE "OriginalFilename", "Password Defense.exe"
            VALUE "ProductName",      "Password Defense"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 keo. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
